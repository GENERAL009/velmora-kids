# ───────────────────────────────────────────
# Velmora Kids Backend - Environment Variables
# ───────────────────────────────────────────

# Project
PROJECT_NAME=Velmora Kids
DEBUG=false

# Database (async driver for the app, sync driver for Alembic)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/velmora_kids
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/velmora_kids

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT / Authentication
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Payment: Payme
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Payment: Click
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Telegram Bot (required for order notifications & payment verification)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_GROUP_ID=
TELEGRAM_ADMIN_IDS=[1566454370,1519994286]

# Backend public URL (for Telegram webhook registration, e.g. ngrok URL)
BACKEND_BASE_URL=https://your-domain-or-ngrok.ngrok-free.app

# CORS (comma-separated list handled by pydantic-settings as JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://corsage-spring-hybrid.ngrok-free.dev/"]
